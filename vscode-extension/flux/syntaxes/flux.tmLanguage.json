{
  "scopeName": "source.flux",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-declarations" },
    { "include": "#builtins" },
    { "include": "#control-keywords" },
    { "include": "#logical-keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#object-keys" },
    { "include": "#assignment-variables" },
    { "include": "#method-calls" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.flux",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.flux",
          "match": "//.*$"
        },
        {
          "name": "comment.block.flux",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.flux",
          "begin": "\\\"\\\"\\\"",
          "end": "\\\"\\\"\\\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.flux" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.flux" }
          },
          "patterns": [
            { "include": "#escapes" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.flux",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.flux" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.flux" }
          },
          "patterns": [
            { "include": "#escapes" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.single.flux",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.flux" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.flux" }
          },
          "patterns": [
            { "include": "#escapes" }
          ]
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.flux",
          "match": "\\\\(u[0-9a-fA-F]{4}|x[0-9a-fA-F]{2}|.)"
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.flux",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.flux" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.flux" }
          },
          "patterns": [
            { "include": "#builtins" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#method-calls" },
            { "include": "#function-calls" },
            { "include": "#operators" },
            { "include": "#variables" }
          ]
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "name": "meta.function.definition.flux",
          "match": "\\b(give)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\()([^)]*)(\\))",
          "captures": {
            "1": { "name": "keyword.other.declaration.flux" },
            "2": { "name": "entity.name.function.declaration.flux" },
            "3": { "name": "punctuation.definition.parameters.begin.flux" },
            "4": { "name": "variable.parameter.flux" },
            "5": { "name": "punctuation.definition.parameters.end.flux" }
          }
        },
        {
          "name": "keyword.other.declaration.flux",
          "match": "\\bgive\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.flux",
          "match": "\\b(say|print|write|input|input_number|warn|fail|debug|clear|exit|len|range|text|number|type_of)\\b"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.flux",
          "match": "\\b(check|if|otherwise|repeat|for|each|in|times|break|next|return)\\b"
        }
      ]
    },
    "logical-keywords": {
      "patterns": [
        {
          "name": "keyword.operator.logical.flux",
          "match": "\\b(and|or|not|is|is not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.flux",
          "match": "\\b(yes|no)\\b"
        },
        {
          "name": "constant.language.null.flux",
          "match": "\\bnothing\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.flux",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.flux",
          "match": "\\b[0-9](_?[0-9])*\\.[0-9](_?[0-9])*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.flux",
          "match": "\\b[0-9](_?[0-9])*\\b"
        }
      ]
    },
    "object-keys": {
      "patterns": [
        {
          "name": "entity.name.tag.key.flux",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "assignment-variables": {
      "patterns": [
        {
          "name": "variable.other.assignment.flux",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s+(?:is|\\+=|-=|\\*=|/=|%=))"
        }
      ]
    },
    "method-calls": {
      "patterns": [
        {
          "name": "support.function.method.flux",
          "match": "(?<=\\.)(upper|lower|trim|split|join|replace|contains|starts_with|ends_with|reverse|push|pop|keys|values|map|filter|sum|avg|min|max|sort|find|take|drop|first|last)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.flux",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.flux",
          "match": "(>=|<=|==|!=|>|<)"
        },
        {
          "name": "keyword.operator.assignment.flux",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.arithmetic.flux",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.arrow.flux",
          "match": "(->|=>)"
        },
        {
          "name": "punctuation.separator.comma.flux",
          "match": ","
        },
        {
          "name": "punctuation.accessor.flux",
          "match": "\\."
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.this.flux",
          "match": "\\b(self|this)\\b"
        },
        {
          "name": "variable.other.readwrite.flux",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
