{
  "name": "ezra-lang",
  "displayName": "Ezra Language",
  "description": "Syntax highlighting, IntelliSense, snippets, run/check/lint/format, LSP, and Ezra Neon theme — by Ankur Rana",
  "version": "1.0.0",
  "publisher": "ankur-rana",
  "author": {
    "name": "Ankur Rana",
    "url": "https://github.com/ranaji114"
  },
  "icon": "icons/flux-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranaji114/Flux-programming-lang.git"
  },
  "bugs": {
    "url": "https://github.com/ranaji114/Flux-programming-lang/issues"
  },
  "homepage": "https://ranaji114.github.io/Flux-programming-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Themes",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "ezra",
    "flux",
    "scripting",
    "ankur-rana",
    "syntax-highlighting",
    "language"
  ],
  "activationEvents": [
    "onLanguage:ezra"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ezra",
        "aliases": [
          "Ezra",
          "ezra"
        ],
        "extensions": [
          ".ez",
          ".ar",
          ".flx"
        ],
        "configuration": "./language-configuration/language-configuration.json",
        "icon": {
          "light": "./icons/flux-icon.png",
          "dark": "./icons/flux-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "ezra",
        "scopeName": "source.ezra",
        "path": "./syntaxes/ezra.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "ezra",
        "path": "./snippets/ezra.json"
      }
    ],
    "themes": [
      {
        "label": "Ezra Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/ezra-neon-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "ezra.runFile",
        "title": "Ezra: Run File",
        "icon": "$(play)"
      },
      {
        "command": "ezra.checkFile",
        "title": "Ezra: Check Syntax"
      },
      {
        "command": "ezra.lintFile",
        "title": "Ezra: Lint File"
      },
      {
        "command": "ezra.formatFile",
        "title": "Ezra: Format File"
      },
      {
        "command": "ezra.openRepl",
        "title": "Ezra: Open REPL"
      },
      {
        "command": "ezra.newProject",
        "title": "Ezra: New Project"
      },
      {
        "command": "ezra.stopRun",
        "title": "Ezra: Stop Running",
        "icon": "$(debug-stop)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "ezra.runFile",
          "when": "resourceLangId == ezra",
          "group": "navigation@1"
        },
        {
          "command": "ezra.stopRun",
          "when": "resourceLangId == ezra && ezra.running",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        { "command": "ezra.runFile",    "when": "resourceLangId == ezra" },
        { "command": "ezra.checkFile",  "when": "resourceLangId == ezra" },
        { "command": "ezra.lintFile",   "when": "resourceLangId == ezra" },
        { "command": "ezra.formatFile", "when": "resourceLangId == ezra" },
        { "command": "ezra.stopRun",    "when": "resourceLangId == ezra" }
      ]
    },
    "configuration": {
      "title": "Ezra Language",
      "properties": {
        "ezra.executablePath": {
          "type": "string",
          "default": "ezra",
          "markdownDescription": "Path to the `ezra` executable. Leave as `ezra` to resolve from PATH and common install locations."
        },
        "ezra.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run the active Ezra file when it is saved. Disable if the program reads input."
        },
        "ezra.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Ezra Language Server (diagnostics, hover, completions, document symbols)."
        },
        "ezra.lsp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Explicit path to the `ezra-lsp` binary. Leave empty to auto-detect next to `ezra`."
        },
        "ezra.lsp.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP communication in the output panel."
        }
      }
    },
    "keybindings": [
      {
        "command": "ezra.runFile",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "resourceLangId == ezra"
      },
      {
        "command": "ezra.runFile",
        "key": "f5",
        "when": "resourceLangId == ezra"
      },
      {
        "command": "ezra.checkFile",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "resourceLangId == ezra"
      },
      {
        "command": "ezra.openRepl",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "resourceLangId == ezra"
      }
    ],
    "configurationDefaults": {
      "[ezra]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.autoClosingBrackets": "always",
        "editor.autoClosingQuotes": "always",
        "editor.trimAutoWhitespace": true,
        "editor.formatOnSave": false
      }
    },
    "problemMatchers": [
      {
        "name": "ezra",
        "owner": "ezra",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^error at (\\d+):(\\d+): (.+)$",
          "line": 1,
          "column": 2,
          "message": 3
        }
      }
    ]
  },
  "scripts": {
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "lint": "eslint extension.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.9.2",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "type": "commonjs"
}
