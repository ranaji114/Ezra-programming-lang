{
  "Hello World": {
    "prefix": ["hello", "hw"],
    "body": ["say \"Hello, Ezra!\""],
    "description": "Classic Hello World"
  },
  "Say (print with newline)": {
    "prefix": "say",
    "body": ["say \"$1\""],
    "description": "Print a value followed by a newline"
  },
  "Write (print without newline)": {
    "prefix": "write",
    "body": ["write \"$1\""],
    "description": "Print a value without a newline"
  },
  "Variable Assignment": {
    "prefix": ["var", "is"],
    "body": ["${1:name} is ${2:\"value\"}"],
    "description": "Assign a variable using 'is'"
  },
  "Let Declaration": {
    "prefix": "let",
    "body": ["let ${1:name}${2:: ${3:text}} is ${4:\"value\"}"],
    "description": "Declare a mutable variable with optional type hint"
  },
  "Const Declaration": {
    "prefix": "const",
    "body": ["const ${1:NAME}${2:: ${3:number}} is ${4:42}"],
    "description": "Declare an immutable constant"
  },
  "Input Text": {
    "prefix": "input",
    "body": ["${1:name} is input \"${2:Enter text: }\""],
    "description": "Read a line of text from stdin"
  },
  "Input Number": {
    "prefix": ["input_number", "innum"],
    "body": ["${1:value} is input_number \"${2:Enter number: }\""],
    "description": "Read a number from stdin"
  },
  "Check If": {
    "prefix": ["check", "if"],
    "body": [
      "check if ${1:condition}",
      "  $2"
    ],
    "description": "Simple conditional"
  },
  "Check If / Otherwise": {
    "prefix": ["checkotherwise", "ifo"],
    "body": [
      "check if ${1:condition}",
      "  ${2:say \"yes\"}",
      "otherwise",
      "  ${3:say \"no\"}"
    ],
    "description": "if / else conditional"
  },
  "Check If / Otherwise If / Otherwise": {
    "prefix": ["checkchain", "elif"],
    "body": [
      "check if ${1:score >= 90}",
      "  say \"${2:A}\"",
      "otherwise if ${3:score >= 75}",
      "  say \"${4:B}\"",
      "otherwise",
      "  say \"${5:try again}\""
    ],
    "description": "if / else-if / else chain"
  },
  "Repeat N Times": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:3} times",
      "  $2"
    ],
    "description": "Repeat a block N times"
  },
  "For Each Loop": {
    "prefix": ["foreach", "for"],
    "body": [
      "for each ${1:item} in ${2:items}",
      "  $3"
    ],
    "description": "Iterate over each item in a list"
  },
  "While Loop": {
    "prefix": "while",
    "body": [
      "${1:i} is ${2:0}",
      "while ${1:i} < ${3:10}",
      "  $4",
      "  ${1:i} += 1"
    ],
    "description": "While loop with counter"
  },
  "Until Loop": {
    "prefix": "until",
    "body": [
      "${1:i} is ${2:0}",
      "until ${1:i} >= ${3:5}",
      "  $4",
      "  ${1:i} += 1"
    ],
    "description": "Until (do-while) loop"
  },
  "Infinite Loop": {
    "prefix": "loop",
    "body": [
      "loop",
      "  $1",
      "  check if ${2:done}",
      "    break"
    ],
    "description": "Infinite loop with break condition"
  },
  "Function Definition": {
    "prefix": ["give", "fn", "func"],
    "body": [
      "give ${1:name}(${2:a, b})",
      "  -> ${3:a + b}"
    ],
    "description": "Define a function with arrow return"
  },
  "Function with Body": {
    "prefix": ["givebody", "fnbody"],
    "body": [
      "give ${1:greet}(${2:name})",
      "  ${3:message} is \"Hello {${2:name}}!\"",
      "  return ${3:message}"
    ],
    "description": "Define a function with a multi-line body"
  },
  "Arrow Function (lambda)": {
    "prefix": ["lambda", "arrow", "=>"],
    "body": ["${1:double} is ${2:n} -> ${3:n * 2}"],
    "description": "Single-expression arrow function"
  },
  "Arrow Function Multi-param": {
    "prefix": ["lambdan", "arrown"],
    "body": ["${1:add} is (${2:a, b}) -> ${3:a + b}"],
    "description": "Multi-parameter arrow function"
  },
  "List Creation": {
    "prefix": "list",
    "body": ["${1:items} is [${2:1, 2, 3}]"],
    "description": "Create a list literal"
  },
  "List Push": {
    "prefix": "push",
    "body": ["${1:list} is ${1:list}.push(${2:value})"],
    "description": "Append a value to a list (returns new list)"
  },
  "List Map": {
    "prefix": "map",
    "body": ["${1:result} is ${2:nums}.map(${3:n} -> ${4:n * 2})"],
    "description": "Transform every element of a list"
  },
  "List Filter": {
    "prefix": "filter",
    "body": ["${1:evens} is ${2:nums}.filter(${3:n} -> ${4:n % 2 is 0})"],
    "description": "Keep elements that pass a test"
  },
  "List Reduce": {
    "prefix": "reduce",
    "body": ["${1:total} is ${2:nums}.reduce((${3:acc}, ${4:n}) -> ${3:acc} + ${4:n}, ${5:0})"],
    "description": "Accumulate a list into a single value"
  },
  "Object Creation": {
    "prefix": ["obj", "object"],
    "body": [
      "${1:user} is {",
      "  name: \"${2:Rana}\",",
      "  age: ${3:20}",
      "}"
    ],
    "description": "Create an object literal"
  },
  "Object Access": {
    "prefix": "dot",
    "body": ["say ${1:user}.${2:name}"],
    "description": "Access an object property"
  },
  "Try / Catch": {
    "prefix": ["try", "trycatch"],
    "body": [
      "try",
      "  $1",
      "catch ${2:err}",
      "  say \"Error: {${2:err}}\""
    ],
    "description": "try / catch error handling"
  },
  "Try / Catch / Finally": {
    "prefix": "tryfinally",
    "body": [
      "try",
      "  $1",
      "catch ${2:err}",
      "  say \"Error: {${2:err}}\"",
      "finally",
      "  $3"
    ],
    "description": "try / catch / finally error handling"
  },
  "Throw Error": {
    "prefix": "throw",
    "body": ["throw \"${1:something went wrong}\""],
    "description": "Throw a runtime error"
  },
  "Assert": {
    "prefix": "assert",
    "body": ["assert ${1:condition}, \"${2:message}\""],
    "description": "Assert a condition is truthy"
  },
  "Pick (pattern match)": {
    "prefix": ["pick", "match", "switch"],
    "body": [
      "pick ${1:value}",
      "  when ${2:\"case1\"}",
      "    $3",
      "  when ${4:\"case2\"}",
      "    $5",
      "  otherwise",
      "    $6"
    ],
    "description": "Pattern match with pick/when"
  },
  "Use Module": {
    "prefix": ["use", "import"],
    "body": ["use \"${1:std/math}\" as ${2:math}"],
    "description": "Import a module"
  },
  "Use From": {
    "prefix": ["from", "importfrom"],
    "body": ["from \"${1:std/math}\" use ${2:sin, cos, pi}"],
    "description": "Import specific names from a module"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Point}",
      "  ${2:x}",
      "  ${3:y}",
      "",
      "${4:p} is ${1:Point}(${5:3, 4})",
      "say ${4:p}.${2:x}"
    ],
    "description": "Define and instantiate a struct"
  },
  "Fibonacci (iterative)": {
    "prefix": "fib",
    "body": [
      "give fib(n)",
      "  check if n <= 1",
      "    -> n",
      "  a is 0",
      "  b is 1",
      "  i is 2",
      "  while i <= n",
      "    c is a + b",
      "    a is b",
      "    b is c",
      "    i += 1",
      "  -> b",
      "",
      "say fib(${1:10})"
    ],
    "description": "Iterative Fibonacci function"
  },
  "Tiny Calculator": {
    "prefix": "calculator",
    "body": [
      "a is input_number \"First number: \"",
      "op is input \"Operation (+  -  *  /): \"",
      "b is input_number \"Second number: \"",
      "",
      "check if op is \"+\"",
      "  say a + b",
      "otherwise if op is \"-\"",
      "  say a - b",
      "otherwise if op is \"*\"",
      "  say a * b",
      "otherwise if op is \"/\"",
      "  check if b is 0",
      "    say \"Cannot divide by zero\"",
      "  otherwise",
      "    say a / b",
      "otherwise",
      "  say \"Unknown operation: {op}\""
    ],
    "description": "Complete interactive calculator example"
  },
  "JSON Round-trip": {
    "prefix": "json",
    "body": [
      "${1:data} is { name: \"${2:Ezra}\", version: ${3:1} }",
      "${4:json} is stringify_json(${1:data})",
      "say ${4:json}",
      "${5:parsed} is parse_json(${4:json})",
      "say ${5:parsed}.name"
    ],
    "description": "JSON encode and decode"
  },
  "File Read/Write": {
    "prefix": ["file", "readfile"],
    "body": [
      "write_file(\"${1:output.txt}\", \"${2:Hello from Ezra!}\")",
      "content is read_file(\"${1:output.txt}\")",
      "say content"
    ],
    "description": "Write and read a file"
  },
  "Range Loop": {
    "prefix": "range",
    "body": [
      "for each ${1:i} in range(${2:10})",
      "  say ${1:i}"
    ],
    "description": "Loop over a range of numbers"
  },
  "Map Object": {
    "prefix": "mapobj",
    "body": [
      "${1:users} is [",
      "  { name: \"${2:Alice}\", age: ${3:30} },",
      "  { name: \"${4:Bob}\",   age: ${5:25} }",
      "]",
      "for each ${6:user} in ${1:users}",
      "  say \"{${6:user}.name} is {${6:user}.age}\""
    ],
    "description": "List of objects pattern"
  }
}
