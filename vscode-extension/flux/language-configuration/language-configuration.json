{
  "comments": {
    "lineComment": "#",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "\"\"\"", "close": "\"\"\"" },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'" },
    { "open": "\"", "close": "\"" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(give|check|otherwise|repeat|for)\\b",
      "end": "^\\s*$"
    }
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "onEnterRules": [
    {
      "beforeText": { "pattern": "^\\s*(give|check|otherwise if|otherwise|repeat.*times|for each).*[^#]$" },
      "action": {
        "indent": "indentOutdent"
      }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(give|check|otherwise if|otherwise|repeat.*times|for each).*[^#]$",
    "decreaseIndentPattern": "^\\s*(otherwise|end)\\b"
  }
}
