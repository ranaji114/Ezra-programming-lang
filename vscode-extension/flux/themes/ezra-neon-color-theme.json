{
  "name": "Ezra Neon",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#cdd9e5",
    "editorLineNumber.foreground": "#3d4f60",
    "editorLineNumber.activeForeground": "#7d9ab5",
    "editorCursor.foreground": "#00e5ff",
    "editor.selectionBackground": "#1d3b53",
    "editor.selectionHighlightBackground": "#1a2f44",
    "editor.wordHighlightBackground": "#1d3045",
    "editorBracketMatch.background": "#1d3b4f",
    "editorBracketMatch.border": "#00e5ff",
    "editorIndentGuide.background1": "#1a2535",
    "editorIndentGuide.activeBackground1": "#00e5ff",
    "editorGutter.background": "#0d1117",
    "activityBar.background": "#0a0d13",
    "activityBar.foreground": "#00e5ff",
    "activityBarBadge.background": "#00e5ff",
    "activityBarBadge.foreground": "#0a0d13",
    "sideBar.background": "#0a0d13",
    "sideBar.foreground": "#8fa3b3",
    "statusBar.background": "#0a3d5c",
    "statusBar.foreground": "#cdd9e5",
    "panel.background": "#0a0d13",
    "tab.activeBackground": "#0d1117",
    "tab.inactiveBackground": "#0a0d13",
    "tab.activeForeground": "#00e5ff",
    "tab.activeBorder": "#00e5ff",
    "titleBar.activeBackground": "#0a0d13",
    "titleBar.activeForeground": "#cdd9e5",
    "terminal.background": "#0a0d13",
    "terminal.foreground": "#cdd9e5",
    "terminal.ansiCyan": "#00e5ff",
    "terminal.ansiGreen": "#5eead4",
    "focusBorder": "#00e5ff",
    "badge.background": "#00e5ff",
    "badge.foreground": "#0a0d13"
  },
  "tokenColors": [
    { "name": "Comments",
      "scope": ["comment", "comment.line.number-sign.ezra", "comment.block.ezra"],
      "settings": { "foreground": "#4a5f73", "fontStyle": "italic" } },
    { "name": "Control flow",
      "scope": ["keyword.control.conditional.ezra", "keyword.control.loop.ezra", "keyword.control.match.ezra"],
      "settings": { "foreground": "#ffcc66", "fontStyle": "bold" } },
    { "name": "Function/type declarations",
      "scope": ["keyword.control.flow.ezra","keyword.declaration.function.ezra","keyword.declaration.struct.ezra","keyword.declaration.enum.ezra","keyword.declaration.impl.ezra","keyword.declaration.variable.ezra"],
      "settings": { "foreground": "#c792ea", "fontStyle": "bold" } },
    { "name": "Error handling",
      "scope": ["keyword.control.exception.ezra"],
      "settings": { "foreground": "#ff5370", "fontStyle": "bold" } },
    { "name": "Module keywords",
      "scope": ["keyword.other.module.ezra"],
      "settings": { "foreground": "#89ddff" } },
    { "name": "Logical operators",
      "scope": ["keyword.operator.logical.ezra","keyword.operator.assignment.word.ezra","keyword.operator.comparison.word.ezra"],
      "settings": { "foreground": "#ff8f70", "fontStyle": "bold" } },
    { "name": "Builtin output",
      "scope": ["support.function.builtin.output.ezra","support.function.builtin.input.ezra"],
      "settings": { "foreground": "#00e5ff", "fontStyle": "bold" } },
    { "name": "Builtin utilities",
      "scope": ["support.function.builtin.type.ezra","support.function.builtin.collection.ezra","support.function.builtin.math.ezra","support.function.builtin.io.ezra","support.function.builtin.os.ezra","support.function.builtin.json.ezra","support.function.builtin.type-check.ezra"],
      "settings": { "foreground": "#4dd0e1" } },
    { "name": "Function declarations",
      "scope": ["entity.name.function.ezra"],
      "settings": { "foreground": "#82aaff", "fontStyle": "bold" } },
    { "name": "Function calls",
      "scope": ["entity.name.function.call.ezra"],
      "settings": { "foreground": "#82aaff" } },
    { "name": "Method calls",
      "scope": ["entity.name.function.method.ezra"],
      "settings": { "foreground": "#00e5ff" } },
    { "name": "Type names",
      "scope": ["entity.name.type.struct.ezra","entity.name.type.enum.ezra","entity.name.type.ezra"],
      "settings": { "foreground": "#f78c6c", "fontStyle": "bold" } },
    { "name": "LHS assignment",
      "scope": ["variable.other.assignment.lhs.ezra"],
      "settings": { "foreground": "#f0abfc" } },
    { "name": "Parameters",
      "scope": ["variable.parameter.ezra"],
      "settings": { "foreground": "#ffd580" } },
    { "name": "self",
      "scope": ["variable.language.self.ezra","keyword.other.self.ezra"],
      "settings": { "foreground": "#f778ba", "fontStyle": "italic" } },
    { "name": "Variables",
      "scope": ["variable.other.readwrite.ezra"],
      "settings": { "foreground": "#c4d7fe" } },
    { "name": "Strings",
      "scope": ["string.quoted.double.ezra"],
      "settings": { "foreground": "#8be28b" } },
    { "name": "Escape sequences",
      "scope": ["constant.character.escape.ezra"],
      "settings": { "foreground": "#f778ba", "fontStyle": "bold" } },
    { "name": "Interpolation braces",
      "scope": ["punctuation.section.interpolation.begin.ezra","punctuation.section.interpolation.end.ezra"],
      "settings": { "foreground": "#f778ba", "fontStyle": "bold" } },
    { "name": "Embedded interpolation",
      "scope": ["source.ezra.embedded"],
      "settings": { "foreground": "#fde68a" } },
    { "name": "Numbers",
      "scope": ["constant.numeric.float.ezra","constant.numeric.integer.ezra"],
      "settings": { "foreground": "#a78bfa" } },
    { "name": "Booleans",
      "scope": ["constant.language.boolean.true.ezra","constant.language.boolean.false.ezra"],
      "settings": { "foreground": "#f59e0b", "fontStyle": "bold" } },
    { "name": "Nothing",
      "scope": ["constant.language.null.ezra"],
      "settings": { "foreground": "#94a3b8", "fontStyle": "italic" } },
    { "name": "Arithmetic operators",
      "scope": ["keyword.operator.arithmetic.ezra","keyword.operator.compound-assignment.ezra"],
      "settings": { "foreground": "#fb7185" } },
    { "name": "Comparison operators",
      "scope": ["keyword.operator.comparison.ezra"],
      "settings": { "foreground": "#ffd580" } },
    { "name": "Arrow / pipe",
      "scope": ["keyword.operator.arrow.ezra","keyword.operator.pipe.ezra"],
      "settings": { "foreground": "#c792ea", "fontStyle": "bold" } },
    { "name": "Bitwise / ternary",
      "scope": ["keyword.operator.bitwise.ezra","keyword.operator.ternary.ezra","keyword.operator.optional-chain.ezra","keyword.operator.spread.ezra"],
      "settings": { "foreground": "#f778ba" } },
    { "name": "Object keys",
      "scope": ["meta.object.member.key.ezra"],
      "settings": { "foreground": "#93c5fd" } },
    { "name": "Punctuation",
      "scope": ["punctuation.separator.comma.ezra","punctuation.accessor.dot.ezra","punctuation.separator.colon.ezra","punctuation.bracket.square.open.ezra","punctuation.bracket.square.close.ezra","punctuation.bracket.paren.open.ezra","punctuation.bracket.paren.close.ezra","punctuation.bracket.brace.open.ezra","punctuation.bracket.brace.close.ezra","punctuation.definition.parameters.begin.ezra","punctuation.definition.parameters.end.ezra"],
      "settings": { "foreground": "#546e7a" } }
  ]
}